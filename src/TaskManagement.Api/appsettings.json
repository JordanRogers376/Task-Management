{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=taskmanagement.db"
  },
  "Jwt": {
    "Key": "TaskManagementDevSecretKey_ChangeInProduction_Min32Chars!",
    "Issuer": "TaskManagement.Api",
    "Audience": "TaskManagement.Clients",
    "ExpireHours": "8"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
